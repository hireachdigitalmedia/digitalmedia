# Server
NODE_ENV=development
PORT=8080
API_PREFIX=api

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# SMTP (contact form). Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Reach Digital Media <no-reply@hireachdigitalmedia.com>"
CONTACT_INBOX=hello@hireachdigitalmedia.com
